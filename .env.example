# Postgres connection string (Vercel Postgres / Neon / Supabase pooler URL).
# If unset, the app falls back to an embedded local database (PGlite) stored
# in ./.data — fine for local dev, NOT for production.
DATABASE_URL=

# Anthropic API key used to parse voice dumps into structured entries.
ANTHROPIC_API_KEY=

# Single-user access code. If unset, auth is disabled (local dev only).
ACCESS_CODE=

# --- Optional: semantic ("deep") search ---
# Free key from voyageai.com — enables search by meaning, not just keywords.
VOYAGE_API_KEY=

# --- Optional: automated off-site backups ---
# Create a PRIVATE GitHub repo (e.g. you/hypnosis-logger-backups), then a
# fine-grained personal access token with Contents read/write on that repo:
# github.com -> Settings -> Developer settings -> Fine-grained tokens.
BACKUP_GITHUB_REPO=
BACKUP_GITHUB_TOKEN=
# Random string; Vercel sends it with cron requests so only the scheduler
# (and you, logged in) can trigger /api/backup.
CRON_SECRET=
