# Postgres connection string (Vercel Postgres / Neon / Supabase pooler URL).
# If unset, the app falls back to an embedded local database (PGlite) stored
# in ./.data — fine for local dev, NOT for production.
DATABASE_URL=

# Anthropic API key used to parse voice dumps into structured entries.
ANTHROPIC_API_KEY=

# Single-user access code. If unset, auth is disabled (local dev only).
ACCESS_CODE=
